{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name_en",
    "name_fr",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,128}$"
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "name_fr": {
      "type": "string",
      "minLength": 1
    },
    "aliases_en": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "aliases_fr": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["ingredient_id", "weight_g", "cooking_method"],
        "additionalProperties": false,
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,128}$"
          },
          "weight_g": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Default weight in grams for one person."
          },
          "cooking_method": {
            "type": "string",
            "enum": ["raw", "boiled", "steamed", "grilled", "roasted", "fried"]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
