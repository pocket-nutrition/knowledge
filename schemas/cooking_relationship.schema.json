{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "raw_id",
    "cooking_method",
    "yield_factor"
  ],
  "additionalProperties": false,
  "properties": {
    "raw_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,128}$"
    },
    "cooking_method": {
      "type": "string",
      "enum": [
        "boiled",
        "steamed",
        "grilled",
        "roasted",
        "fried",
        "cooked"
      ]
    },
    "yield_factor": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5.0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "ciqual_pair",
        "mccance_pair",
        "usda_pair",
        "usda_sr_pair",
        "usda_foundation_pair",
        "usda_yield",
        "usda_yield_mp_r2",
        "manual"
      ]
    },
    "notes": {
      "type": "string"
    },
    "nutrient_retention": {
      "type": "object",
      "description": "USDA SR28 retention factor per nutrient after cooking (0.0–1.0). Absent key = 1.0 (no degradation assumed).",
      "additionalProperties": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
    }
  }
}